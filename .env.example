# .env.example을 .env로 복사해서 채운다. (.env는 git에 올라가지 않는다)
# 키를 비워 두면 개발 환경에서는 가짜 AI와 가짜 결제창으로 모든 흐름을 테스트할 수 있다.

# ---------- 기본 ----------
PORT=3000
# 운영 주소. 페이앱 결제통보(feedbackurl)와 결제 후 돌아올 주소에 쓴다.
APP_URL=https://example.com
# 아무 긴 랜덤 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# /admin 화면 비밀번호
ADMIN_KEY=
# SQLite 파일과 업로드 파일 위치. 운영 서버에서는 지워지지 않는 디스크(볼륨) 경로로 둔다.
DATA_DIR=./data
SERVICE_NAME=스터디AI

# ---------- 요금 ----------
# Pro 월간(매달 자동 결제)과 연간(1년치 한 번 결제). 기본값은 유니브AI 웹 가격.
# 예전 PLAN_LIFETIME_PRICE는 더 이상 쓰지 않는다 (남아 있어도 영향 없음).
PLAN_MONTHLY_PRICE=9900
PLAN_YEARLY_PRICE=82800
# 무료 플랜 한도 (주간 횟수는 매주 월요일 0시 한국 시간에 다시 채워진다)
FREE_WEEKLY_FILES=2
FREE_WEEKLY_YOUTUBE=2
FREE_DAILY_TUTOR=10
FREE_WEEKLY_EXAMS=1
FREE_MAX_FILE_MB=50
PRO_MAX_FILE_MB=1024
# Pro 공정 사용 상한 (최근 30일 업로드 수). 0이면 제한 없음
PRO_MONTHLY_UPLOADS=0

# ---------- 결제 (페이앱) ----------
# 페이앱 판매자 사이트 > 설정 > 연동 정보
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# 같은 화면의 '결제 KEY'. API 요청 해시와 결제통보 해시 검증에 쓴다.
PAYAPP_REQUESTKEY=
# 결제창에 보이는 상점명
PAYAPP_SHOPNAME=스터디AI

# ---------- AI (Claude) ----------
# PDF·사진 읽기, 요약/퀴즈/개념 등 학습 자료, AI 튜터를 모두 Claude가 한다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# 원가 계산용 단가 (USD / 100만 토큰). Claude Haiku 5.5: 프롬프트 10만 토큰 이하 0.10/0.50, 초과 0.50/2.50
AI_PRICE_INPUT_PER_M_USD=0.1
AI_PRICE_OUTPUT_PER_M_USD=0.5
AI_PRICE_INPUT_LONG_PER_M_USD=0.5
AI_PRICE_OUTPUT_LONG_PER_M_USD=2.5
USD_KRW=1400

# ---------- 선택: 녹음 파일·유튜브 자동 받아쓰기 (Gemini) ----------
# Claude는 소리와 영상을 읽지 못한다. 비워 두면 녹음은 브라우저 실시간 자막, 유튜브는 붙여 넣은 자막을 쓴다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- 메타 픽셀 ----------
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ---------- 사업자 정보 (사이트 하단, 약관에 들어간다. 개인판매자는 사업자번호 칸을 비워 둔다) ----------
BIZ_NAME=
BIZ_OWNER=
BIZ_REG_NO=
BIZ_MAIL_ORDER_NO=
BIZ_ADDRESS=
BIZ_PHONE=
BIZ_EMAIL=
BIZ_PRIVACY_OFFICER=
