# .env.example을 .env로 복사해서 채운다. (.env는 git에 올라가지 않는다)
# 키를 비워 두면 개발 환경에서는 가짜 AI와 가짜 결제창으로 모든 흐름을 테스트할 수 있다.

# ---------- 기본 ----------
PORT=3000
# 운영 주소. 페이앱 결제통보(feedbackurl)와 결제 후 돌아올 주소에 쓴다.
APP_URL=https://example.com
# 아무 긴 랜덤 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# /admin 화면 비밀번호
ADMIN_KEY=
# SQLite 파일과 업로드 파일 위치. 운영 서버에서는 지워지지 않는 디스크(볼륨) 경로로 둔다.
DATA_DIR=./data
SERVICE_NAME=스터디AI

# ---------- 요금 ----------
PLAN_MONTHLY_PRICE=9900
PLAN_YEARLY_PRICE=82800
# 무료 플랜 한도
FREE_WEEKLY_FILES=2
FREE_WEEKLY_YOUTUBE=2
FREE_DAILY_TUTOR=10
FREE_WEEKLY_EXAMS=1
FREE_MAX_FILE_MB=50
PRO_MAX_FILE_MB=1024

# ---------- 결제 (페이앱) ----------
# 페이앱 판매자 사이트 > 설정 > 연동 정보
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# 같은 화면의 '결제 KEY'. API 요청 해시와 결제통보 해시 검증에 쓴다.
PAYAPP_REQUESTKEY=
# 결제창에 보이는 상점명
PAYAPP_SHOPNAME=스터디AI

# ---------- AI (Gemini) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 2.5 Flash는 0이면 생각 토큰을 쓰지 않아 빠르고 싸다. 다른 모델에서 오류가 나면 비운다.
GEMINI_THINKING_BUDGET=0
# 원가 계산용 단가 (USD / 100만 토큰). 모델을 바꾸면 공식 가격표에 맞춰 고친다.
AI_PRICE_INPUT_PER_M_USD=0.3
AI_PRICE_OUTPUT_PER_M_USD=2.5
USD_KRW=1400

# ---------- 메타 픽셀 ----------
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ---------- 사업자 정보 (사이트 하단, 약관에 들어간다. 개인판매자는 사업자번호 칸을 비워 둔다) ----------
BIZ_NAME=
BIZ_OWNER=
BIZ_REG_NO=
BIZ_MAIL_ORDER_NO=
BIZ_ADDRESS=
BIZ_PHONE=
BIZ_EMAIL=
BIZ_PRIVACY_OFFICER=
