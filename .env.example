# .env.example을 .env로 복사해서 채운다. (.env는 git에 올라가지 않는다)

# ---------- 기본 ----------
PORT=3000
# 운영 주소. 결제 성공/실패 리다이렉트와 전환 API에 쓴다.
APP_URL=https://example.com
# 아무 긴 랜덤 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# /admin 화면 비밀번호
ADMIN_KEY=
# SQLite 파일 위치. 운영 서버에서는 지워지지 않는 디스크(볼륨) 경로로 둔다.
DATA_DIR=./data

# ---------- 상품 ----------
SERVICE_NAME=오늘사주
PLAN_NAME=AI 사주 월 구독
PLAN_PRICE=9900
PLAN_DAYS=30
CHAT_DAILY_LIMIT=20
REPORT_MONTHLY_LIMIT=10

# ---------- 결제 (토스페이먼츠) ----------
# auto: 카드 등록 후 매월 자동결제. 토스 '자동결제' 추가 심사와 계약이 필요하다.
# pass: 30일 이용권 단건결제. 일반 카드결제 계약만으로 된다. 자동결제 심사 전 임시로 쓴다.
BILLING_MODE=auto
# 개발자센터 > API 키 > 'API 개별 연동 키' (test_ck_ / test_sk_ 로 시작). 결제위젯 키(gck)가 아니다.
# 비워 두면 개발 환경에서 가짜 결제(mock)로 흐름만 테스트한다. 운영에서는 필수.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 갱신 결제 확인 주기(분)와 실패 시 재시도 횟수(하루 1번)
RENEWAL_INTERVAL_MIN=60
RENEWAL_MAX_RETRIES=3
# 외부 크론으로 POST /api/cron/renew 를 부를 때 x-cron-secret 헤더 값 (선택)
CRON_SECRET=

# ---------- AI (Gemini) ----------
# 비워 두면 개발 환경에서 가짜 풀이로 흐름만 테스트한다. 운영에서는 필수.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 2.5 Flash는 0이면 생각 토큰을 쓰지 않아 빠르고 싸다. 다른 모델에서 오류가 나면 비운다.
GEMINI_THINKING_BUDGET=0
# 원가 계산용 단가 (USD / 100만 토큰). 모델을 바꾸면 공식 가격표에 맞춰 고친다.
AI_PRICE_INPUT_PER_M_USD=0.3
AI_PRICE_OUTPUT_PER_M_USD=2.5
USD_KRW=1400

# ---------- 메타 픽셀 ----------
META_PIXEL_ID=
# 전환 API 토큰 (이벤트 관리자 > 설정 > 전환 API). 비워 두면 브라우저 픽셀만 쓴다.
META_CAPI_TOKEN=
# 이벤트 관리자 '이벤트 테스트' 탭의 코드. 테스트할 때만 넣고 운영에서는 비운다.
META_TEST_EVENT_CODE=

# ---------- 사업자 정보 (PG 심사 때 사이트 하단에 반드시 있어야 한다) ----------
BIZ_NAME=
BIZ_OWNER=
BIZ_REG_NO=
BIZ_MAIL_ORDER_NO=
BIZ_ADDRESS=
BIZ_PHONE=
BIZ_EMAIL=
BIZ_PRIVACY_OFFICER=
