# .env.example을 .env로 복사해서 채운다. (.env는 git에 올라가지 않는다)
# 키를 비워 두면 개발 환경에서는 가짜 AI와 가짜 결제창으로 모든 흐름을 테스트할 수 있다.

# ---------- 기본 ----------
PORT=3000
# 운영 주소. 페이앱 결제통보(feedbackurl)와 결제 후 돌아올 주소에 쓴다.
APP_URL=https://example.com
# 아무 긴 랜덤 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# /admin 화면 비밀번호
ADMIN_KEY=
# SQLite 파일과 업로드 파일 위치. 운영 서버에서는 지워지지 않는 디스크(볼륨) 경로로 둔다.
DATA_DIR=./data
SERVICE_NAME=스터디AI

# ---------- 요금 ----------
# 단건 결제 하나: 한 번 결제하면 평생 Pro
PLAN_LIFETIME_PRICE=9900
# 무료 플랜 한도
FREE_WEEKLY_FILES=2
FREE_WEEKLY_YOUTUBE=2
FREE_DAILY_TUTOR=10
FREE_WEEKLY_EXAMS=1
FREE_MAX_FILE_MB=50
PRO_MAX_FILE_MB=1024
# 평생 이용권 공정 사용 상한 (한 달 업로드 수). 0이면 제한 없음
PRO_MONTHLY_UPLOADS=0

# ---------- 결제 (페이앱) ----------
# 페이앱 판매자 사이트 > 설정 > 연동 정보
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# 같은 화면의 '결제 KEY'. API 요청 해시와 결제통보 해시 검증에 쓴다.
PAYAPP_REQUESTKEY=
# 결제창에 보이는 상점명
PAYAPP_SHOPNAME=스터디AI

# ---------- AI (Claude) ----------
# PDF·사진 읽기, 요약/퀴즈/개념 등 학습 자료, AI 튜터를 모두 Claude가 한다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# 원가 계산용 단가 (USD / 100만 토큰). Claude Haiku 5.5: 프롬프트 10만 토큰 이하 0.10/0.50, 초과 0.50/2.50
AI_PRICE_INPUT_PER_M_USD=0.1
AI_PRICE_OUTPUT_PER_M_USD=0.5
AI_PRICE_INPUT_LONG_PER_M_USD=0.5
AI_PRICE_OUTPUT_LONG_PER_M_USD=2.5
USD_KRW=1400

# ---------- 선택: 녹음 파일·유튜브 자동 받아쓰기 (Gemini) ----------
# Claude는 소리와 영상을 읽지 못한다. 비워 두면 녹음은 브라우저 실시간 자막, 유튜브는 붙여 넣은 자막을 쓴다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- 선택: 소셜 로그인 (카카오·네이버·구글, 모두 무료) ----------
# 비워 두면 그 버튼이 화면에 안 나온다 (이메일 로그인만). 받는 법은 docs/소셜 로그인 설정.md
# 콜백 주소는 APP_URL(없으면 Render 주소) + /api/auth/kakao/callback, /api/auth/naver/callback
# 카카오 디벨로퍼스 > [앱] > [플랫폼 키] > REST API 키
KAKAO_REST_API_KEY=
# 같은 화면 REST API 키 > [클라이언트 시크릿] > [코드]. 새 앱은 [활성화]가 기본 ON이라 꼭 넣는다
KAKAO_CLIENT_SECRET=
# [플랫폼 키] > JavaScript 키 (공개 값). 있으면 폰에서 카카오톡 앱으로 바로 로그인, 없으면 카카오 웹 로그인 화면
KAKAO_JS_KEY=
# 네이버 개발자센터 > 내 애플리케이션 > Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글 클라우드 콘솔의 웹 클라이언트 ID (xxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# 개발용: 1이면 진짜 키 없이 가짜 카카오·네이버·구글 로그인으로 흐름을 시험한다. 운영(NODE_ENV=production)에서는 무시된다.
SOCIAL_LOGIN_MOCK=

# ---------- 메타 픽셀 ----------
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ---------- 사업자 정보 (사이트 하단, 약관에 들어간다. 개인판매자는 사업자번호 칸을 비워 둔다) ----------
BIZ_NAME=
BIZ_OWNER=
BIZ_REG_NO=
BIZ_MAIL_ORDER_NO=
BIZ_ADDRESS=
BIZ_PHONE=
BIZ_EMAIL=
BIZ_PRIVACY_OFFICER=
