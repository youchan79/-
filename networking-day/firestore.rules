rules_version = '2';

// 오늘의 5명 (2026 Physical AI Networking Day) Firestore 보안 규칙
// 콘솔에 붙여넣기 전에 아래 '여기에-관리자-PIN'을 운영진만 아는 값(8자 이상 권장)으로 바꾸세요.
// 이 PIN은 이 규칙 안에만 있고 웹페이지 코드에는 들어가지 않습니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 행사가 끝나면 읽기·쓰기를 모두 막습니다. 기간을 바꾸려면 날짜만 고치세요.
    function open() {
      return request.auth != null && request.time < timestamp.date(2026, 12, 1);
    }
    function owns(pid) {
      return open() && exists(/databases/$(database)/documents/owners/$(pid)/uids/$(request.auth.uid));
    }
    function ownsAfter(pid) {
      return open() && existsAfter(/databases/$(database)/documents/owners/$(pid)/uids/$(request.auth.uid));
    }
    function isAdmin() {
      return open() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function list(v, min, max) {
      return v is list && v.size() >= min && v.size() <= max;
    }
    function linkedin(v) {
      return v is string && (v == '' || (v.size() <= 200 && v.matches('https://www[.]linkedin[.]com/(in|pub)/[^\\s?#]+')));
    }
    // 테스트 참가자(test: true)는 운영자만 만들고, 시연용 SVG 로고를 쓸 수 있습니다.
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'company', 'companyIntro', 'logo', 'title', 'field', 'years',
                               'careers', 'experiences', 'keywords', 'lookingFor', 'topic',
                               'hidden', 'done', 'test', 'createdAt', 'updatedAt'])
        && d.get('test', false) is bool
        && str(d.name, 1, 20)
        && str(d.company, 1, 30)
        && str(d.get('companyIntro', ''), 0, 40)
        && (d.get('logo', null) == null
            || (d.logo is string && d.logo.size() <= 150000
                && (d.logo.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+')
                    || (d.get('test', false) == true && d.logo.matches('data:image/svg[+]xml;charset=utf-8,[^<>"]*')))))
        && str(d.title, 1, 30)
        && str(d.field, 1, 20)
        && str(d.years, 1, 20)
        && list(d.get('careers', []), 0, 3)
        && list(d.experiences, 1, 3)
        && list(d.get('keywords', []), 0, 5)
        && list(d.get('lookingFor', []), 0, 3)
        && str(d.topic, 1, 60)
        && d.hidden is bool
        && d.done is bool;
    }

    // 이름+뒤 4자리 해시 → 프로필 id. 해시를 아는 사람만 한 건씩 조회할 수 있고 목록은 볼 수 없습니다.
    // 새 키는 아직 없는 프로필만 가리킬 수 있어서 남의 프로필을 가로챌 수 없습니다.
    match /keys/{hash} {
      allow get: if open();
      allow create: if open()
        && request.resource.data.keys().hasOnly(['pid'])
        && str(request.resource.data.pid, 1, 40)
        && !exists(/databases/$(database)/documents/profiles/$(request.resource.data.pid));
    }

    // 이 기기(익명 uid)가 프로필 주인이라는 표시. 키 해시를 알아야 만들 수 있습니다.
    match /owners/{pid}/uids/{uid} {
      allow get: if open() && request.auth.uid == uid;
      allow create: if open() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['k'])
        && request.resource.data.k is string
        && getAfter(/databases/$(database)/documents/keys/$(request.resource.data.k)).data.pid == pid;
    }

    // 공개 프로필: 참가자 누구나 읽고, 주인만 고칩니다.
    // 운영자는 숨기기, 테스트 참가자 만들기, 전체 초기화(삭제)만 할 수 있습니다.
    match /profiles/{pid} {
      allow read: if open();
      allow create: if validProfile(request.resource.data)
        && request.resource.data.hidden == false
        && request.resource.data.done == false
        && ((ownsAfter(pid) && request.resource.data.get('test', false) == false)
            || (isAdmin() && request.resource.data.get('test', false) == true));
      allow update: if (ownsAfter(pid) && validProfile(request.resource.data)
                        && request.resource.data.hidden == resource.data.hidden
                        && request.resource.data.get('test', false) == resource.data.get('test', false))
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
                        && request.resource.data.hidden is bool);
      allow delete: if isAdmin();
    }

    // 내 링크드인 주소(선택)와 '대화했어요' 표시: 본인만 읽고 씁니다. 링크드인은 고른 사람에게 LIKE와 함께 전달됩니다.
    match /private/{pid} {
      allow read: if owns(pid);
      allow create, update: if ownsAfter(pid)
        && request.resource.data.keys().hasOnly(['linkedin', 'met', 'updatedAt'])
        && linkedin(request.resource.data.get('linkedin', ''))
        && list(request.resource.data.get('met', []), 0, 100);
      allow delete: if isAdmin();
    }

    // 내가 고른 사람·넘긴 사람: 본인만 읽고 씁니다. 고르기는 최대 5명.
    match /swipes/{pid} {
      allow read: if owns(pid);
      allow create, update: if ownsAfter(pid)
        && request.resource.data.keys().hasOnly(['likes', 'passes', 'updatedAt'])
        && list(request.resource.data.likes, 0, 5)
        && list(request.resource.data.passes, 0, 100);
      allow delete: if isAdmin();
    }

    // 나를 고른 사람: 받은 사람과 보낸 사람만 읽습니다. 운영자도 읽을 수 없습니다.
    // 보낸 사람의 고른 목록(swipes)에 실제로 있어야만 만들 수 있어서 5명 제한을 우회할 수 없습니다.
    // ln: 보낸 사람의 링크드인 주소(선택). 화면에는 서로 고른 경우에만 보입니다.
    match /inbox/{toPid}/likes/{fromPid} {
      allow read: if owns(toPid) || owns(fromPid);
      allow create, update: if ownsAfter(fromPid) && fromPid != toPid
        && request.resource.data.keys().hasOnly(['at', 'ln'])
        && linkedin(request.resource.data.get('ln', ''))
        && toPid in getAfter(/databases/$(database)/documents/swipes/$(fromPid)).data.likes;
      allow delete: if isAdmin()
        || (ownsAfter(fromPid) && !(toPid in getAfter(/databases/$(database)/documents/swipes/$(fromPid)).data.likes));
    }

    // 진행 단계와 전체 알림: 모두 읽고 운영자만 바꿉니다.
    match /settings/{id} {
      allow read: if open();
      allow write: if isAdmin() && id == 'event'
        && request.resource.data.keys().hasOnly(['phase', 'notice', 'noticeAt', 'updatedAt'])
        && request.resource.data.phase in ['registration', 'swipe', 'ended']
        && str(request.resource.data.get('notice', ''), 0, 60);
    }

    // 운영자 기기 등록: PIN이 맞아야 만들어집니다. 다른 사람은 읽을 수 없습니다.
    match /admins/{uid} {
      allow get: if open() && request.auth.uid == uid;
      allow create: if open() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin == '여기에-관리자-PIN';
    }
  }
}
