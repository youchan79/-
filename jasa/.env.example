# ── 필수 ───────────────────────────────────────────────
# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=""
# 사용할 모델. 기본값 gemini-flash-latest 는 항상 최신 Flash 모델을 가리킵니다.
GEMINI_MODEL="gemini-flash-latest"

# ── 선택: 로그인·저장·사용량 제한 (Supabase) ─────────────
# 비워 두면 '로컬 모드'로 동작합니다: 로그인 없이, 작성한 내용은 이 브라우저에만 저장.
# 설정 방법은 README.md 의 "로그인 켜기" 참고.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# 무료 회원의 하루 AI 사용 횟수
FREE_DAILY_LIMIT="10"

# ── 선택: 결제 (토스페이먼츠, 로그인 설정이 있어야 동작) ──────
# 개발자센터(https://developers.tosspayments.com)의 '결제위젯 연동 키'. 테스트 키(test_...)로 먼저 확인하세요.
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""
# 프로 요금제 30일 가격(원)
PRO_PRICE="9900"

PORT="3000"
